# ByaHero Environment Configuration
# Copy this to .env and fill in your values

# Flask
FLASK_DEBUG=0
PORT=3000
BYAHERO_SECRET_KEY=your-secret-key-here

# LLM-powered Konduktor (optional - falls back to rule-based if not set)
# Get Anthropic API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Or OpenAI API key from https://platform.openai.com/
OPENAI_API_KEY=

# LLM Configuration
KONDUKTOR_USE_LLM=auto          # auto, true, false
KONDUKTOR_LLM_PROVIDER=anthropic  # anthropic or openai
KONDUKTOR_LLM_MODEL=claude-3-5-sonnet-20241022
KONDUKTOR_MAX_TOKENS=2000
KONDUKTOR_TEMPERATURE=0.3